# FantasyPros API key (required for live data; omit to run entirely on mock data)
FANTASYPROS_API_KEY=

# Safety margin under the account's real daily request cap (e.g. 50/day).
# Kept a few calls below the actual limit as headroom for manual debugging.
FANTASYPROS_DAILY_LIMIT=45

# Hours a cached response is served before another live call is allowed
FANTASYPROS_CACHE_TTL_HOURS=12
